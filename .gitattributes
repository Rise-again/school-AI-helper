# 统一换行，避免 Windows 上 checkout 后 shell 脚本带 CRLF 无法执行
*.sh      text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.txt     text eol=lf
*.example text eol=lf
*.ps1     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.pdf     binary
*.pptx    binary
