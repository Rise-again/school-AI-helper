# 校园智能助手 · 配置模板
# 复制为 backend/.env 后填写。install.sh 会自动生成随机密钥并写入。
# 所有键都会被 Pydantic 校验：缺必填项或仍是占位值，服务直接拒绝启动。

# ===== 运行环境 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=campus
MYSQL_PASSWORD=__MYSQL_PASSWORD__
MYSQL_DB=campus_assistant
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10

# ===== 鉴权（至少 32 字符，install.sh 会自动生成）=====
JWT_SECRET=__JWT_SECRET__
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=720
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 大模型（vLLM，OpenAI 兼容）=====
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=EMPTY
LLM_TIMEOUT_S=60

# ===== 功能模型（model-service：embedding / rerank / ocr）=====
EMBED_BASE_URL=http://127.0.0.1:8002
RERANK_BASE_URL=http://127.0.0.1:8002
OCR_BASE_URL=http://127.0.0.1:8002

# ===== 解析与切片（bge 与 reranker 均为 512 token 上限）=====
PARSE_PDF_MODE=page
OCR_MIN_CHARS=50
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=480
CHUNK_OVERLAP_TOKENS=80

# ===== 检索 =====
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=campus_kb
EMBED_BATCH_SIZE=32
RAG_TOP_K=20
RAG_TOP_N=5
RAG_SCORE_THRESHOLD=0.35

# ===== 数据获取（可选：不填则只用静态知识库）=====
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_API_KEY=
ANYSEARCH_ZONE=cn
ANYSEARCH_DAILY_QUOTA=900

# ===== 教务系统（正方）=====
EDU_HOST=zfjw.hntou.edu.cn
EDU_PORT=80
EDU_SSL=false
EDU_TIMEOUT_S=10
EDU_RETRY=2

# ===== 限流与队列（单 worker 内存实现）=====
RATE_LIMIT_PER_MINUTE=20
QUEUE_MAX_SIZE=50
QUEUE_MAX_WAIT_S=30

# ===== 上传 =====
UPLOAD_DIR=data/uploads
UPLOAD_MAX_MB=50

# ===== 跨域（前端开发服务器）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
