# ===== 运行环境 =====
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=改成你的密码
MYSQL_DB=campus_assistant
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10

# ===== 鉴权（至少 32 字符）=====
JWT_SECRET=请替换为至少32位的随机字符串
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=720
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 大模型（云端 vLLM，OpenAI 兼容）=====
LLM_BASE_URL=http://你的云端IP:8001/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=EMPTY
LLM_TIMEOUT_S=60

# ===== 功能模型（云端 model-service）=====
EMBED_BASE_URL=http://你的云端IP:8002
RERANK_BASE_URL=http://你的云端IP:8002
OCR_BASE_URL=http://你的云端IP:8002

# ===== 检索 =====
CHROMA_DIR=data/chroma
RAG_TOP_K=20
RAG_TOP_N=5
RAG_SCORE_THRESHOLD=0.35

# ===== 数据获取 =====
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_API_KEY=填你的Key
ANYSEARCH_ZONE=cn
ANYSEARCH_DAILY_QUOTA=900
EDU_HOST=zfjw.hntou.edu.cn
EDU_PORT=80
EDU_SSL=false
EDU_TIMEOUT_S=10
EDU_RETRY=2

# ===== 限流与队列（单 worker 内存实现）=====
RATE_LIMIT_PER_MINUTE=20
QUEUE_MAX_SIZE=50
QUEUE_MAX_WAIT_S=30

# ===== 上传 =====
UPLOAD_DIR=data/uploads
UPLOAD_MAX_MB=50
